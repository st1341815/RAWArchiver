<Window x:Class="RawArchiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAW 归档 v1.1.0" Width="1020" Height="840"
        MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="RAW 归档" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="v1.1.0" Margin="8,0,0,0" VerticalAlignment="Bottom" Foreground="Gray"/>
            <Button x:Name="AboutButton" Content="关于" Margin="16,0,0,0" Click="AboutButton_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="PreviewButton" Content="预览" Width="80" Click="PreviewButton_Click"/>
            <Button x:Name="StartButton" Content="开始归档" Width="90" Margin="8,0,0,0" Click="StartButton_Click"/>
            <Button x:Name="CancelButton" Content="取消" Width="70" Margin="8,0,0,0" Click="CancelButton_Click"/>
            <Button x:Name="OpenOutButton" Content="打开输出目录" Width="110" Margin="8,0,0,0" Click="OpenOutButton_Click"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 源目录 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="源（SD/TF/U 盘或本地目录）" FontWeight="SemiBold"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="选择目录…" Width="90" Click="SourceButton_Click"/>
                    <TextBox x:Name="SourceBox" TextChanged="SourceBox_TextChanged"/>
                </DockPanel>
            </StackPanel>

            <!-- 输出目录 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="输出目录（归档落点）" FontWeight="SemiBold"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="选择目录…" Width="90" Click="OutputButton_Click"/>
                    <TextBox x:Name="OutputBox" TextChanged="OutputBox_TextChanged"/>
                </DockPanel>
            </StackPanel>

            <!-- 选项 -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <CheckBox x:Name="BrandCheck" Content="按品牌分层" Margin="0,0,16,0" Checked="OptionChanged" Unchecked="OptionChanged"/>
                <CheckBox x:Name="JpgCheck" Content="处理 JPG" IsChecked="True" Margin="0,0,16,0" Checked="OptionChanged" Unchecked="OptionChanged"/>
                <CheckBox x:Name="VideoCheck" Content="处理视频" IsChecked="True" Margin="0,0,16,0" Checked="OptionChanged" Unchecked="OptionChanged"/>
                <CheckBox x:Name="StagingCheck" Content="内部暂存（卡源推荐，暂存会先拷到系统盘）" IsChecked="True" Margin="0,0,16,0" Checked="OptionChanged" Unchecked="OptionChanged"/>
            </WrapPanel>

            <!-- 模式 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="模式：" VerticalAlignment="Center"/>
                <ComboBox x:Name="ModeCombo" Width="180" SelectionChanged="OptionChanged">
                    <ComboBoxItem Content="复制（保留源文件）" Tag="copy"/>
                    <ComboBoxItem Content="移动（归档后清空源）" Tag="move"/>
                </ComboBox>
            </StackPanel>

            <!-- 汇总 + 警告 -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
                <TextBlock x:Name="WarningText" Foreground="#E67E22" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 预览表 / 进度 -->
            <Grid Grid.Row="5">
                <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="源文件" Binding="{Binding Src}" Width="*"/>
                        <DataGridTextColumn Header="拍摄日期" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="日期来源" Binding="{Binding DateFrom}" Width="90"/>
                        <DataGridTextColumn Header="目标路径" Binding="{Binding Dst}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <ProgressBar x:Name="TaskProgress" Height="18"/>
                    <TextBlock x:Name="ProgressText" Margin="0,6,0,6"/>
                    <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Height="160" AcceptsReturn="True"/>
                </StackPanel>
            </Grid>

            <StatusBar Grid.Row="6">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="就绪"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>
