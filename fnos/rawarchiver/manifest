appname               = rawarchiver
version               = 1.0.9
display_name          = RAW 归档
desc                  = 相机照片/视频按拍摄日期（EXIF）归档工具。从 SD/TF/U 盘或本地目录读取拍摄日期，按 YYYYMMDD 归档到指定 NAS 目录；源只读、可断点续跑、可清源，并生成机器可消费的报告。内置 ExifTool；照片无 EXIF 视为未知并跳过，视频可用文件时间兜底。
source                = thirdparty
platform              = all
maintainer            = uncle13
distributor           = uncle13
desktop_uidir         = ui
desktop_applaunchname = rawarchiver.Application
ctl_stop              = true
checkport             = false
disable_authorization_path = false
changelog             = v1.0.9 输出目录「选取文件夹」改用飞牛宿主 /app-auth 原生目录选择器（参考 file.dedupe 的重定向回调模式，新增 www/auth-callback.html，弃用 TrimApp 桥）；v1.0.8 修复：宿主桥握手不响应时「选取文件夹」卡死无反应；v1.0.7 输出目录「选取文件夹」优先调用飞牛自带文件夹选择框；v1.0.6 输出目录改用「选取文件夹」目录选择窗口（服务端目录浏览 API browse），替代原「创建目录」按钮；v1.0.5 更换应用图标；v1.0.4 桌面入口默认窗口 800×600；首个版本：按 EXIF 拍摄日期归档 RAW/JPG/视频；预览 / 复制 / 移动、断点续跑、清源与报告。
